{
  "name": "atomico-base",
  "description": "a repo to start with atomico",
  "meta": {
    "id": "vite",
    "title": "Started - Atomico + Vite(JS,JSX,TS,TSX)",
    "description": "Hassle-free starter template, perfect for starting with Atomico",
    "branch": "https://github.com/atomicojs/atomico/tree/2-started/"
  },
  "workspaces": [
    "src/*"
  ],
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "create:component": "scaff component-tsx src"
  },
  "dependencies": {
    "atomico": "^2.2.0"
  },
  "devDependencies": {
    "@atomico/scaffold": "^2.9.5",
    "@atomico/tsconfig": "^1.1.2",
    "@atomico/vite": "^3.1.0",
    "vite": "^7.3.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  }
}
